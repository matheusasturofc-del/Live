# Copie este arquivo para config.env e preencha:  cp config.env.example config.env

# ===== Destino da live =====
# YouTube: rtmp://a.rtmp.youtube.com/live2
# Twitch:  rtmp://live.twitch.tv/app   (ou o servidor mais próximo de você)
# Kick / Facebook / outros: use a "URL do servidor" que a plataforma mostrar
RTMP_URL="rtmp://a.rtmp.youtube.com/live2"
STREAM_KEY="cole-sua-chave-de-transmissao-aqui"

# ===== Modo =====
# videos -> toca em loop (embaralhado) os vídeos de midia/videos
# imagem -> uma imagem fixa (midia/imagem) + músicas em loop (midia/musicas)
MODO="videos"

# Embaralhar a ordem a cada volta da playlist (1 = sim, 0 = não)
EMBARALHAR=1

# ===== Qualidade =====
RESOLUCAO="1280x720"     # 1920x1080 exige uma máquina mais forte
FPS=30
BITRATE_VIDEO="3000k"    # 720p: 2500k-4000k | 1080p: 4500k-6000k
BITRATE_AUDIO="128k"
PRESET="veryfast"        # ultrafast = menos CPU, pior qualidade

# 1 = não recodifica (quase zero de CPU). Só use depois de rodar ./preparar.sh
COPIAR_SEM_RECODIFICAR=0
