# Serviço systemd: liga a live junto com o servidor e reinicia se travar.
# Instalação (ajuste o caminho se não clonou em /opt/live):
#   sudo cp live.service /etc/systemd/system/live.service
#   sudo systemctl daemon-reload && sudo systemctl enable --now live
[Unit]
Description=Live infinita 24/7
After=network-online.target
Wants=network-online.target

[Service]
WorkingDirectory=/opt/live
ExecStart=/opt/live/live.sh
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
